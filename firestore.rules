rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User document and nested subcollections
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      match /habits/{habitId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(habitId);
      }

      match /completions/{completionId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(completionId);
      }

      match /pianoSongs/{songId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(songId);
      }

      match /pianoLogs/{logId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(logId);
      }

      match /quickNotes/{noteId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(noteId);
      }
    }
  }
}
